{
  "name": "mahjong-tool",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "check:conflicts": "node scripts/check-conflicts.mjs",
    "build": "npm run check:conflicts && REACT_ROUTER_BUILD_DIRECTORY=build react-router build",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run check:conflicts && node --test app/lib/mahjong.test.ts"
  },
  "dependencies": {
    "@react-router/cloudflare": "^7.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "@react-router/node": "^7.15.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.15.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
